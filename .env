# Copy this file to .env and fill in real values. Never commit the real .env.

# Django
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB (REQUIRED — this is the application's actual database)
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_DB_NAME=quizcraft

# CORS (comma separated). Leave blank in DEBUG mode - all origins are
# allowed automatically for local development.
CORS_ALLOWED_ORIGINS=

# Google Sign-In (OPTIONAL). Leave blank to keep the Google login button
# hidden on the login/register pages — it will NOT be shown as if it
# worked when it isn't actually configured.
GOOGLE_CLIENT_ID=
